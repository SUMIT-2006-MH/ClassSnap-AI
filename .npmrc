# Prefer prebuilt native binaries — avoids node-gyp compilation on Windows
prefer-offline=false

# Use a cache directory outside of OneDrive to prevent EPERM file-locking errors
# (OneDrive syncs node_modules files mid-write, causing permission conflicts)
cache=C:\npm-cache

# Do not hoist native modules — keeps better-sqlite3 isolated
# so Next.js server bundle can exclude it cleanly
